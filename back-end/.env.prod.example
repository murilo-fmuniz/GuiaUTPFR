# Production Environment Variables
# Copie este arquivo para .env.prod e preencha com valores reais

# Database
DB_USER=postgres
DB_PASSWORD=senha-super-segura-aleatorio
DB_NAME=chatbot_db

# Security - GERAR CHAVE SEGURA: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=gerar-chave-aleatoria-segura

# Groq API
GROQ_API_KEY=sua-chave-groq-producao

# CORS - Adicione os domínios reais
CORS_ORIGINS=https://guia-utpfr.vercel.app

# Optional: JWT expiry time in minutes
# JWT_EXPIRY_MINUTES=60

# Optional: Groq API URL
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
